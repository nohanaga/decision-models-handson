# このファイルを両ノートブックと同じフォルダーに .env としてコピーしてください。
# カーネルの作業フォルダーも同じフォルダーにしてください。
# .env の値は既存の環境変数を上書きします。
# 変更後は各ノートブックの 0-2 と 0-3 を再実行してください。

# 共通: true は Microsoft Entra ID 認証、false は API キー認証です。
# Microsoft Entra ID 認証では、各リソースへの利用権限が必要です。
USE_ENTRA_ID=true

# 共通: API キー認証時のみ使用します。Entra ID 認証では空欄のままにします。
# 同じリソースの API キーだけを共用できます。
# 別リソースのキーが必要なら空欄のままにし、各ノートブックで非表示入力します。
# 実際のキーを記入するのは .env のみです。このサンプルには記入しないでください。
AZURE_API_KEY=

# Azure OpenAI Decisions API
# 実際のルート URL に置き換えてください。/openai/v1/ は付けません。
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
# モデル名ではなく、作成したデプロイの名前を指定します。
AZURE_OPENAI_DECISIONS_DEPLOYMENT=gpt-6-luna

# Microsoft-Decision-1
# デプロイ詳細ページのリソースのルート URL に置き換えてください。
# /api/projects/... や /providers/microsoft/v1/systemone は付けません。
MICROSOFT_DECISION_ENDPOINT=https://YOUR-RESOURCE-NAME.services.ai.azure.com
MICROSOFT_DECISION_DEPLOYMENT=Microsoft-Decision-1

# 接続先の参考:
# https://learn.microsoft.com/azure/foundry/openai/how-to/decisions
# https://learn.microsoft.com/azure/foundry/foundry-models/how-to/use-foundry-models-microsoft-decision#call-the-decision-api
